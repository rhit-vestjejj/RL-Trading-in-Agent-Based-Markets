\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Persistence of one-sided states. Both the maximum consecutive duration (left) and 90th-percentile episode length (right) spike sharply at $\phi = 0.30$--$0.40$.}}{2}{figure.caption.8}\protected@file@percent }
\newlabel{fig:duration}{{2}{2}{Persistence of one-sided states. Both the maximum consecutive duration (left) and 90th-percentile episode length (right) spike sharply at $\phi = 0.30$--$0.40$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Evidence that $\phi = 0.5$ is a market shutdown rather than liquidity recovery. The drop in one-sided-book failures coincides with near-total inactivity, zero-return behavior, and collapsed quote activity.}}{3}{figure.caption.9}\protected@file@percent }
\newlabel{fig:shutdown-support}{{3}{3}{Evidence that $\phi = 0.5$ is a market shutdown rather than liquidity recovery. The drop in one-sided-book failures coincides with near-total inactivity, zero-return behavior, and collapsed quote activity}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Side-Specific Liquidity Failures}{3}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Missing best-bid and missing best-ask fractions vs.\ $\phi $ (greedy and stochastic evaluation). The ask side fails predominantly, revealing a buy-bias in the learned policy that systematically depletes ask-side liquidity.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:liquidity-modes}{{4}{4}{Missing best-bid and missing best-ask fractions vs.\ $\phi $ (greedy and stochastic evaluation). The ask side fails predominantly, revealing a buy-bias in the learned policy that systematically depletes ask-side liquidity}{figure.caption.10}{}}
