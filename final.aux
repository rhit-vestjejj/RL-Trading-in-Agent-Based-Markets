\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Evidence That $\phi = 0.5$ Reflects Shutdown Rather Than Recovery}{4}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Evidence that $\phi = 0.5$ is shutdown-like rather than a liquidity recovery. The drop in one-sided-book failures coincides with sharply higher inactivity, sharply higher zero-return behavior, and collapsed quote activity.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:shutdown-support}{{3}{4}{Evidence that $\phi = 0.5$ is shutdown-like rather than a liquidity recovery. The drop in one-sided-book failures coincides with sharply higher inactivity, sharply higher zero-return behavior, and collapsed quote activity}{figure.caption.5}{}}
