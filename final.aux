\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Analytical threshold $\phi ^*$ vs.\ empirical one-sided book fraction. Left: aggregate consumption rate $C(\phi )$ and provision rate $P(\phi )$ cross at $\phi ^* \approx 0.30$ (shaded band shows uncertainty from $\lambda _r$ estimates). Right: empirical one-sided fraction with the predicted threshold overlaid; the sharp empirical rise aligns with the crossing point.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:threshold}{{9}{6}{Analytical threshold $\phi ^*$ vs.\ empirical one-sided book fraction. Left: aggregate consumption rate $C(\phi )$ and provision rate $P(\phi )$ cross at $\phi ^* \approx 0.30$ (shaded band shows uncertainty from $\lambda _r$ estimates). Right: empirical one-sided fraction with the predicted threshold overlaid; the sharp empirical rise aligns with the crossing point}{figure.caption.11}{}}
